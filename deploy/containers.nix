# deploy/containers.nix
# Source of truth of the containers TAKEN OUT of the host conf.
#
# Why: changing an image, a port or an environment variable must no longer
# cost an eval of tower's NixOS conf (90 s idle, 4 to 5 min under
# load) nor a new generation. `just deploy <name>` renders a podman
# quadlet file and restarts the unit. No nixos-rebuild is launched.
#
# This file is NOT imported by the host conf: it enters no eval of
# nixosConfigurations. It is exposed by the flake under `deploy.containers`.
#
# Migration order, once per service and never half-way:
#   1. `just deploy <name>`: the quadlet is placed, the container runs.
#   2. only then, remove the block
#      `virtualisation.oci-containers.containers.<name>` from the module, and change
#      `migrated` to true here.
# Reversing the order removes the container on the next switch.
#
# What REMAINS in the host conf after migration:
#   - the newt/Pangolin route and the exposure assertions;
#   - the sops.templates / sops.secrets declarations, because the quadlet reads
#     the file rendered by sops-nix (/run/secrets/rendered/<name>.env). No
#     secret is written in this repo nor in the quadlet.
#
# Not migratable for now: docs-compare/wikijs, whose config.yml is a
# file generated by nix in the host conf (it would have to be taken out of the module).
{
  # ── Migrated (module already removed from the host conf) ────────────────────────

  # ── To migrate (step 1 done by hand, step 2 not yet) ─────────────

  shlink-web-client = {
    migrated = true;
    description = "Shlink web administration client";
    image = "docker.io/shlinkio/shlink-web-client:4.9.0";
    publish = ["127.0.0.1:8100:8080"];
    env = {
      SHLINK_SERVER_URL = "https://s.marcpartensky.com";
      SHLINK_SERVER_NAME = "marcpartensky";
    };
    health = {
      cmd = "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1";
      interval = "30s";
      timeout = "10s";
      retries = 3;
    };
  };

  aonsoku = {
    migrated = true;
    description = "Subsonic/Navidrome web client (autologin, SSO gate only)";
    image = "ghcr.io/victoralvesf/aonsoku:latest";
    publish = ["127.0.0.1:8099:8080"];
    env = {
      SERVER_URL = "https://navidrome.marcpartensky.com";
      HIDE_SERVER = "true";
      SERVER_TYPE = "navidrome";
      APP_THEME = "catppuccin-mocha";
      # Automatic login: the SPA has no account of its own, so these two
      # variables remove the Subsonic prompt entirely (the image renders
      # /usr/share/nginx/html/env-config.js from the container env at startup).
      # APP_PASSWORD is NOT here: it comes from /run/secrets/aonsoku_env
      # (sops secret declared in services/aonsoku.nix).
      # Consequence: the credentials are readable by anyone who loads the page,
      # so the Pangolin SSO gate on music.marcpartensky.com is the ONLY
      # authentication left. Never turn it off while the autologin is on.
      APP_USER = "aonsoku";
      APP_AUTH_TYPE = "token";
    };
    envFiles = ["/run/secrets/aonsoku_env"];
    health = {
      cmd = "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1";
      interval = "30s";
      timeout = "10s";
      retries = 3;
    };
  };

  arr-mcp = {
    migrated = true;
    description = "arr MCP server (Radarr, Sonarr, Jellyfin, Prowlarr)";
    image = "ghcr.io/bardesss/arr-mcp:latest";
    publish = ["127.0.0.1:6060:6060"];
    # /config carries config.yaml (service URLs, token hash, Jellyfin
    # default_user): the application config that the dashboard rewrites. Without this
    # volume, config.yaml starts from scratch on each container recreation, and
    # the old version of the quadlet mounted none.
    volumes = ["/var/lib/hermes/arr-mcp:/config"];
    # API keys of the four services, as placeholders ${RADARR_API_KEY} etc.
    # in config.yaml. Rendered by sops-nix (services/arr-mcp): no key
    # in this repo nor in the volume.
    envFiles = ["/run/secrets/arr_mcp_env"];
    env = {
      ARR_MCP_PORT = "6060";
    };
    # The image is a node distroless+node base: neither curl nor wget. The check
    # goes through `node -e fetch` (verified on 23/11/2026).
    health = {
      cmd = "node -e \"fetch('http://127.0.0.1:6060/').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1));\"";
      interval = "30s";
      timeout = "10s";
      retries = 3;
    };
  };

  nextcloud-mcp = {
    migrated = true;
    description = "Nextcloud MCP server";
    image = "ghcr.io/cbcoutinho/nextcloud-mcp-server:latest";
    network = "host";
    cmd = ["--host" "127.0.0.1" "--port" "8710"];
    env = {
      NEXTCLOUD_HOST = "http://127.0.0.1:8083";
      MCP_DEPLOYMENT_MODE = "single_user_basic";
    };
    envFiles = ["/run/secrets/nextcloud_mcp_env"];
  };

  reactive-resume = {
    migrated = false;
    description = "Resume generator (Pangolin cv.marcpartensky.com)";
    image = "docker.io/amruthpillai/reactive-resume:v5.2";
    network = "host";
    unitAfter = ["network-online.target" "postgresql.service"];
    volumes = ["/var/lib/reactive-resume/data:/app/data"];
    envFiles = ["/run/secrets/rendered/reactive-resume.env"];
    health = {
      cmd = "node -e \"fetch('http://127.0.0.1:8098/api/health').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1));\"";
      interval = "30s";
      timeout = "10s";
      retries = 3;
    };
  };

  shlink = {
    migrated = false;
    description = "Shlink URL shortener (API + public redirects)";
    image = "docker.io/shlinkio/shlink:stable";
    network = "host";
    unitAfter = ["network-online.target" "postgresql.service"];
    volumes = ["/var/lib/shlink/data:/etc/shlink/data"];
    envFiles = ["/run/secrets/rendered/shlink.env"];
    # No healthcheck in the container: the image guarantees neither curl nor
    # wget. Health is checked by Pangolin on /rest/health.
  };

  # Two containers on a dedicated podman network, no host publication for
  # surrealdb: the script creates the network if missing.
  open-notebook-surreal = {
    migrated = false;
    description = "Open Notebook SurrealDB database";
    image = "docker.io/surrealdb/surrealdb:v2";
    networks = ["open-notebook"];
    user = "root";
    volumes = ["/var/lib/open-notebook/surreal:/mydata"];
    cmd = ["start" "--log" "info" "--user" "root" "--pass" "root" "rocksdb:/mydata/mydatabase.db"];
  };

  open-notebook = {
    migrated = false;
    description = "Open Notebook (UI + API)";
    image = "docker.io/lfnovo/open_notebook:v1-latest";
    networks = ["open-notebook"];
    publish = ["127.0.0.1:8502:8502" "127.0.0.1:5055:5055"];
    volumes = ["/var/lib/open-notebook/data:/app/data"];
    env = {
      API_URL = "https://notebook.marcpartensky.com";
    };
    envFiles = ["/run/secrets/rendered/open-notebook.env"];
  };
}
