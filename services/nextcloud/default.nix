{
  pkgs,
  config,
  lib,
  ...
}: {
  environment.systemPackages = [pkgs.nextcloud33];

  sops.secrets = {
    # The name on the left (e.g. "nextcloud/adminUser") will be the file name in /run/secrets/
    # The "key" key points to the structure in your YAML file (e.g. nextcloud: adminUser: ...)

    "nextcloud/admin_user" = {
      owner = "nextcloud"; # Important: Nextcloud must be able to read this file
      group = "nextcloud";
      key = "nextcloud_admin_user";
    };

    "nextcloud/user" = {
      owner = "nextcloud"; # Important: Nextcloud must be able to read this file
      group = "nextcloud";
      key = "nextcloud_user";
    };

    "nextcloud/admin_password" = {
      owner = "nextcloud";
      group = "nextcloud";
      key = "nextcloud_admin_password";
    };

    # Database password
    "nextcloud/password" = {
      owner = "nextcloud";
      group = "nextcloud";
      key = "nextcloud_password";
    };

    # Client secret of the Zitadel OIDC app "Nextcloud". Dedicated file because the
    # migrated OIDC apps each have their own Zitadel project (one role per app):
    # see secrets/zitadel-oidc-secrets.yml and the oneshot below.
    "nextcloud/oidc_client_secret" = {
      owner = "nextcloud";
      group = "nextcloud";
      mode = "0400";
      sopsFile = ../../secrets/zitadel-oidc-secrets.yml;
      key = "nextcloud_client_secret";
    };
  };

  services.nginx.virtualHosts."localhost" = {
    listen = [
      {
        addr = "0.0.0.0";
        port = 8083;
        # locations."= /.well-known/openid-configuration".extraConfig = ''
        #   rewrite ^ /index.php$request_uri last;
        # '';
      }
    ];
  };

  # ---------------------------------------------------------------------------
  # CONFIGURATION NEXTCLOUD
  # ---------------------------------------------------------------------------
  services.nextcloud = {
    enable = true;
    package = pkgs.nextcloud33;

    hostName = "localhost";

    autoUpdateApps.enable = false;
    appstoreEnable = false;
    configureRedis = true;

    settings = {
      loglevel = 0;
      auth.bruteforce.protection.enabled = false;
      auth.sso-enabled = false;
      trusted_domains = [
        "localhost"
        "127.0.0.1"
        "192.168.1.44"
        "cloud.vps.marcpartensky.com"
        "cloud.marcpartensky.com"
        "cloud.p2p.marcpartensky.com"
      ];
      # If Traefik is on HTTPS and Nextcloud on HTTP behind it:
      overwriteprotocol = "https";
      overwritehost = "cloud.marcpartensky.com";
      "overwrite.cli.url" = "https://cloud.marcpartensky.com";
      overwritecondaddr = "^127\\.0\\.0\\.1$"; # the overwrite only applies to requests coming from the reverse proxy
      trusted_proxies = ["127.0.0.1" "::1"];
    };

    config = {
      dbtype = "pgsql";
      dbuser = "nextcloud";

      # Use of the Unix socket (more performant and secure)
      dbhost = "/run/postgresql";

      # Injection of the secrets via the paths generated by SOPS
      # user = config.sops.secrets."nextcloud/user".path;
      # adminuser = config.sops.secrets."nextcloud/admin_user";
      adminuser = "root";
      adminpassFile = config.sops.secrets."nextcloud/admin_password".path;
      dbpassFile = config.sops.secrets."nextcloud/password".path;
    };

    extraApps = {
      inherit
        (config.services.nextcloud.package.packages.apps)
        news
        contacts
        tasks
        calendar
        deck
        memories
        notes
        user_oidc # OIDC CONSUMER: allows logging into Nextcloud WITH
        # a zitadel account (auth.marcpartensky.com). The provider config
        # ("Zitadel", client_id 317450151415316483) is already in the database in
        # oc_user_oidc_providers; the app being uninstalled, it was
        # simply unusable. The already-linked accounts are in oc_user_oidc.
        ;
      # WARNING: "oidc" (H2CK) is the REVERSE, Nextcloud as an OIDC PROVIDER.
      # Kept because external clients may be registered there (oc_oidc_clients).
      oidc = pkgs.fetchNextcloudApp {
        url = "https://github.com/H2CK/oidc/releases/download/2.3.1/oidc-2.3.1.tar.gz";
        hash = "sha256-zfdZSUwV8VZ5qq7rwN/G4cSfTbuutaK+yJ6g8556yOQ=";
        license = "agpl3Plus";
      };
    };
    extraAppsEnable = true;
  };

  systemd.services.nextcloud-cron.path = [pkgs.procps];
  systemd.services.nextcloud-setup = {
    # postgresql.service is Type=notify: `after` = socket ready. The
    # nixpkgs module only adds this ordering if database.createLocally = true; here the
    # database is declared by ensureDatabases/ensureUsers, so without these lines
    # nextcloud-setup started in parallel with postgres startup and died
    # on "connection to server on socket "/run/postgresql/.s.PGSQL.5432"
    # failed: No such file or directory" (boots of 22/10 20:29 and 23/10 09:37).
    after = ["postgresql.service"];
    requires = ["postgresql.service"];
    path = [pkgs.procps];
    serviceConfig = {
      # Change this value to force a re-run at the next switch: re-activates
      # the extraApps apps (fix 2026-09-22: calendar declared but never
      # activated, oc_calendars tables missing -> 500 CalDAV errors).
      Environment = ["NC_SETUP_FORCE_RUN=20260924"];
      # app:enable does NOT run the migrations: without an upgrade afterwards, the
      # apps' tables (oc_calendars...) are never created.
      ExecStartPost = [
        "${config.services.nextcloud.occ}/bin/nextcloud-occ upgrade"
        # adminpassFile only sets the password on the initial install
        # (occ maintenance:install): on an already-installed instance it is
        # silently ignored. This ExecStartPost forces the "root"
        # account password to the sops value on EVERY activation (self-healing,
        # runs on each switch). Added on 28/09/2026 after a file
        # services/nextcloud/password.txt committed in cleartext (public repo):
        # forced rotation to invalidate any old exposed value.
        "${pkgs.writeShellScript "nextcloud-rotate-admin-password" ''
          set -euo pipefail
          export OC_PASS="$(cat ${config.sops.secrets."nextcloud/admin_password".path})"
          ${config.services.nextcloud.occ}/bin/nextcloud-occ user:resetpassword --password-from-env root
        ''}"
      ];
    };
  };

  # Launched by nextcloud-setup, but it also opens the database: same guard
  # (it failed at the boot of 23/10 09:37 on the missing socket).
  systemd.services.nextcloud-update-db = {
    after = ["postgresql.service"];
    requires = ["postgresql.service"];
  };

  # ---------------------------------------------------------------------------
  # OIDC ZITADEL: a DEDICATED PROJECT per app, hence its own client_id
  # ---------------------------------------------------------------------------
  # `user_oidc` encrypts the client_secret in the database with the instance secret:
  # a direct SQL UPDATE breaks the login return ("Failed to decrypt the OIDC
  # provider client secret"). occ is the only path that encrypts correctly,
  # and it is idempotent (finds the provider by its identifier "Zitadel" and
  # only replaces the fields provided: the numeric id and the linked accounts
  # survive). Without --clientsecret-file the secret must be on the command
  # line; we prefer the sops file. Template copied from nextcloud-cron.
  systemd.services.nextcloud-oidc-provider = {
    description = "Declares the Zitadel OIDC provider (Nextcloud project) in user_oidc";
    after = ["postgresql.service" "nextcloud-setup.service"];
    requires = ["postgresql.service"];
    wantedBy = ["multi-user.target"];
    path = [pkgs.coreutils];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      User = "nextcloud";
      Group = "nextcloud";
      # The nixpkgs occ wrapper reads the Postgres password via credential
      # (nix_read_secret('dbpass')): without it, no more database.
      LoadCredential = ["dbpass:${config.sops.secrets."nextcloud/password".path}"];
    };
    script = ''
      ${config.services.nextcloud.occ}/bin/nextcloud-occ user_oidc:provider Zitadel \
        --clientid 400636686217838892 \
        --clientsecret-file ${config.sops.secrets."nextcloud/oidc_client_secret".path} \
        --discoveryuri https://auth.marcpartensky.com/.well-known/openid-configuration \
        --endsessionendpointuri https://auth.marcpartensky.com/oidc/v1/end_session \
        --postlogouturi https://cloud.marcpartensky.com/ \
        --scope "openid email profile"
    '';
  };

  # ---------------------------------------------------------------------------
  # DATABASE CONFIGURATION (PostgreSQL)
  # ---------------------------------------------------------------------------
  services.postgresql = {
    enable = true;

    ensureDatabases = ["nextcloud"];
    ensureUsers = [
      {
        name = "nextcloud";
        ensureDBOwnership = true;
      }
    ];

    # "Peer" authentication via Socket
    authentication = lib.mkOverride 10 ''
      # TYPE  DATABASE    USER        METHOD
      local   nextcloud   nextcloud   peer
      local   all         all         peer
    '';
  };
}
