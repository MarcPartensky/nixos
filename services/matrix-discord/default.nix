# services/matrix-discord/default.nix
# Matrix <-> Discord bridge (mautrix-discord), server: ../matrix
{
  pkgs,
  lib,
  ...
}: let
  dataDir = "/var/lib/mautrix-discord";
in {
  services.mautrix-discord = {
    enable = true;
    settings = {
      homeserver = {
        address = "http://127.0.0.1:8008";
        domain = "matrix.marcpartensky.com";
      };

      # WARNING: the module declares homeserver/appservice/bridge as
      # `types.attrs` WITHOUT merging (unlike mautrix-signal and
      # mautrix-whatsapp which do a recursiveUpdate): as soon as you write into
      # one of these keys, the WHOLE default of the key is replaced. So we copy
      # here the nixpkgs 26.05 module default, changing only what we want
      # (hostname 0.0.0.0 -> 127.0.0.1).
      appservice = {
        address = "http://127.0.0.1:29334";
        hostname = "127.0.0.1";
        port = 29334;
        database = {
          type = "sqlite3";
          uri = "file:${dataDir}/mautrix-discord.db?_txlock=immediate";
          max_open_conns = 20;
          max_idle_conns = 2;
          max_conn_idle_time = null;
          max_conn_lifetime = null;
        };
        id = "discord";
        bot = {
          username = "discordbot";
          displayname = "Discord bridge bot";
          avatar = "mxc://maunium.net/nIdEykemnwdisvHbpxflpDlC";
        };
        ephemeral_events = true;
        async_transactions = false;
        as_token = "This value is generated when generating the registration";
        hs_token = "This value is generated when generating the registration";
      };

      # same: the module default sets permissions."*" = "relay" (the whole
      # instance can relay); we restrict it to marc's domain + admin.
      bridge = {
        command_prefix = "!discord";
        permissions = {
          "matrix.marcpartensky.com" = "user";
          "@marc:matrix.marcpartensky.com" = "admin";
        };
        # portals encrypted by default (like whatsapp), require=false to not
        # break rooms that cannot be encrypted (server
        # channels notably). pickle_key stable outside the store, cf. the export
        # added further down in mautrix-discord-registration.
        encryption = {
          allow = true;
          default = true;
          require = false;
          pickle_key = "$ENCRYPTION_PICKLE_KEY";
        };
      };
    };
  };

  # The module does NOT generate the registration in the bridge's preStart: it's
  # mautrix-discord-registration.service that does the envsubst of config.yaml then
  # --generate-registration. The key export must therefore be IN this script
  # (an export in an ExecStartPre would not survive the following process).
  systemd.services.mautrix-discord-registration.script = lib.mkBefore ''
    if [ ! -f ${dataDir}/pickle_key.txt ]; then
      ${pkgs.openssl}/bin/openssl rand -hex 32 > ${dataDir}/pickle_key.txt
      chmod 600 ${dataDir}/pickle_key.txt
    fi
    export ENCRYPTION_PICKLE_KEY=$(cat ${dataDir}/pickle_key.txt)
  '';

  # The bridge's config.yaml is regenerated by the registration unit, but the
  # bridge does not reread it on its own: we declare a restart trigger so that
  # the switch restarts mautrix-discord.service when this file changes.
  systemd.services.mautrix-discord.restartTriggers = [./default.nix];

  # nixpkgs BUG (verified 25/09/2026, still present on master): the module
  # creates /var/lib/mautrix-discord as 0770 mautrix-discord:mautrix-discord
  # (tmpfiles rule) while the registration file is chgrp'd to the group
  # mautrix-discord-registration, the only group synapse is a member of. Synapse
  # therefore cannot even TRAVERSE the directory and dies at startup
  # ("PermissionError: /var/lib/mautrix-discord/discord-registration.yaml"),
  # which puts the whole homeserver into a crash-loop.
  #
  # We put the directory back into the registration group, as 0750. WARNING about
  # the TYPE of the rule: systemd-tmpfiles accepts only ONE line of the
  # "ownership" type (d/f/L/c/b/C...) per path; a second `d` line
  # is rejected with "Duplicate line for path "...", ignoring." and mkAfter
  # changes nothing (the first wins, so the module's). You need a `z` line
  # (mode/owner adjustment of an existing path), which coexists
  # with the module's `d`. Verified by reproducing both cases by hand:
  #   d + d -> "Duplicate line", directory left as 0770 mautrix-discord
  #   d + z -> applied, directory as 0750 ...:mautrix-discord-registration
  systemd.tmpfiles.rules = lib.mkAfter [
    "z ${dataDir} 0750 mautrix-discord mautrix-discord-registration -"
  ];

  # No dependency inversion here: the module creates
  # mautrix-discord-registration.service and starts matrix-synapse after
  # it (unlike whatsapp/signal which generate the registration in the
  # service's own preStart).
  #
  # After deployment, Discord login (to be done by marc), in the DM of
  # @discordbot:matrix.marcpartensky.com:
  #   login-qr                   scan with the mobile Discord app (CAPTCHA not handled)
  #   login-token user <token>   self-bot: Authorization header from F12,
  #                              against Discord ToS
  #   login-token bot <token>    dedicated app + bot on discord.com/developers,
  #                              Server Members + Message Content intents, then
  #                              add the bot to servers (no personal DMs)
}
