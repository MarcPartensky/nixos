# services/photos/default.nix
# Phone photos (camera, WhatsApp, Messenger): local tree on the
# ZFS dataset `nixos/marc/media` (mounted on /home/marc/media) + S3 mirror in
# Garage, one bucket per source.
#
# WHY a dataset and not one more folder: a quota that prevents the photos
# from filling the pool (tower is at 76 %), snapshots independent of the rest of the home
# (services.zfs.autoSnapshot takes them separately), and a controllable owner.
# /home/marc/media is root:root 0755 at install (disko), so the
# Syncthing service that runs as marc could NOT write there: the activation
# below switches the tree back to marc:users.
#
# Two entry paths, because Android lets no shell read
# /storage/emulated/0 (scoped storage):
#   1. adb (the initial stock): `scripts/photos-pull.sh` (hermes) writes
#      directly into the tree, source by source.
#   2. Syncthing (the continuous one): folders declared on the tower side and on the phone side.
# Both write into the same tree, hence the `photos` group (marc + hermes)
# in 2770 setgid: each writes, and the created files stay readable by
# the other. No staging folder nor root unit to move the files.
#
# The S3 mirror is a nightly `rclone sync` (04:00): the source of truth stays
# the dataset, Garage is the object copy (and what other tools read as S3).
# `scripts/photos-status.sh` compares the local tree and the buckets.
{ config, lib, pkgs, ... }:
let
  garageState = "/var/lib/garage";
  photosRoot = "/home/marc/media/photos";

  # local source -> Garage bucket. S3 has no folders: one bucket per
  # source to be able to isolate, count and back up each separately.
  sources = {
    camera = "photos-camera";
    whatsapp = "photos-whatsapp";
    messenger = "photos-messenger";
  };
in
{
  # Shared group of the photos tree: marc (Syncthing) and hermes (adb pull).
  users.groups.photos = {
    members = [ "marc" "hermes" ];
  };

  # Tree + owner + quota of the dataset. Idempotent: runs on each
  # switch, touches nothing if it is already in place.
  system.activationScripts.photos-tree = ''
    install -d -m 2770 -o marc -g photos ${photosRoot}
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList (
      name: _: "install -d -m 2770 -o marc -g photos ${photosRoot}/${name}"
    ) sources)}
    # Quota: 150 G on the media dataset. The pool has ~206 G free, and ZFS
    # slows down beyond 80-85 % usage: better a write refusal
    # than a pool in distress. Idempotent (zfs set rewrites the same value).
    ${pkgs.zfs}/bin/zfs set quota=150G nixos/marc/media 2>/dev/null || true
  '';

  # S3 mirror: one rclone sync per source, with the credentials generated by
  # garage-bootstrap. Failures are reported but do not make the
  # service fail: the S3 copy is a redundancy, not the source of truth.
  systemd.services.photos-to-garage = {
    description = "S3 mirror of the photos to Garage (one bucket per source)";
    after = [ "garage.service" ];
    wants = [ "garage.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Nice = 10;
      IOSchedulingClass = "idle";
      # Bounds the burst: three rclone in parallel took 185 to 251 % each
      # and saturated the machine while the nightly window is supposed to be
      # free time.
      CPUQuota = "200%";
      IOWeight = 20;
    };
    path = [ pkgs.rclone pkgs.coreutils ];
    script = ''
      set -eu
      if [ ! -s ${garageState}/s3-key.env ]; then
        echo "photos-to-garage: no Garage credentials, nothing to do" >&2
        exit 0
      fi
      set -a
      . ${garageState}/s3-key.env
      set +a
      export RCLONE_CONFIG_GARAGE_TYPE=s3
      export RCLONE_CONFIG_GARAGE_PROVIDER=Other
      export RCLONE_CONFIG_GARAGE_ENDPOINT=http://127.0.0.1:3900
      export RCLONE_CONFIG_GARAGE_REGION=garage
      export RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
      export RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"

      ${lib.concatStringsSep "\n" (lib.mapAttrsToList (src: bucket: ''
        if [ -d ${photosRoot}/${src} ]; then
            rclone sync ${photosRoot}/${src} garage:${bucket} \
              --transfers 2 --checkers 4 \
              --exclude '.thumbnails/**' --exclude '*.tmp' --exclude '.nomedia' \
              || echo "photos-to-garage: ${src} failed" >&2
          fi
      '') sources)}
    '';
  };

  systemd.timers.photos-to-garage = {
    description = "Nightly S3 mirror of the photos to Garage";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      # One pass per night, not every hour: each sync walks the whole
      # tree and pins one dnode per file in the ZFS ARC. On an hourly schedule over
      # 6 h of uptime this reached 15.9 GB of dnodes for a cap of 16 GB,
      # ARC unable to evict (evict_not_enough 22.9 M), arc_prune/arc_evict
      # in a loop and ~9.8 average cores out of 16 measured on 20/11/2026.
      OnCalendar = "*-*-* 04:00:00";
      Persistent = true;
      RandomizedDelaySec = 1800;
    };
  };

  # rclone in CLI for hermes: check the buckets without waiting for it to be
  # in the system PATH (it is not there).
  environment.systemPackages = [ pkgs.rclone ];
}
