.env
# .sops.yml devrait être commité normalement (contient les clés publiques)
# secrets/*.yml chiffrés peuvent être commités
# secrets/*.dec fichiers déchiffrés temporaires
secrets/*.dec
secrets/*.unencrypted
result*
*.iso

# Python bytecode (ex. services/hinge-auto/__pycache__/)
__pycache__/
*.pyc

# artefacts de build du service presence (jamais versionnes)
services/presence/rust/target/
